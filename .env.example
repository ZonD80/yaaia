# Runtime data. Defaults to ~/yaaia.
YAAIA_HOME=~/yaaia

# Telegram text chat. Create API credentials at https://my.telegram.org/apps.
YAAIA_TELEGRAM_API_ID=
YAAIA_TELEGRAM_API_HASH=
YAAIA_TELEGRAM_PHONE=
# Alternative to phone login:
YAAIA_TELEGRAM_BOT_TOKEN=
YAAIA_TELEGRAM_DATABASE_KEY=change-this-local-key
# Apple Silicon should use ./scripts/install-tdlib.sh to build a current arm64 TDLib.
YAAIA_TDLIB_LIBRARY_PATH=

# Google OAuth desktop credentials JSON.
YAAIA_GOOGLE_CREDENTIALS=~/yaaia/google/credentials.json
YAAIA_GOOGLE_TOKEN=~/yaaia/google/token.json
# Optional: if credentials JSON is missing, setup can create it from these.
YAAIA_GOOGLE_CLIENT_ID=
YAAIA_GOOGLE_CLIENT_SECRET=
YAAIA_GOOGLE_POLL_SECONDS=300

# Optional Telegram voice calls. Requires `pip install -r requirements-voice.txt`.
# Calls use py-tgcalls/ntgcalls for Telegram media and mlx-audio for STT/TTS.
YAAIA_CALLS_ENABLED=0
YAAIA_CALLS_SESSION_DIR=~/yaaia/telegram/calls
YAAIA_CALLS_AUTO_ACCEPT=0
YAAIA_CALLS_TEXT_FALLBACK=1
YAAIA_CALLS_SAMPLE_RATE=48000
YAAIA_CALLS_CHANNELS=2
YAAIA_MLX_TTS_MODEL=mlx-community/Qwen3-TTS-12Hz-1.7B-Base-8bit
YAAIA_MLX_TTS_VOICE=Chelsie
YAAIA_MLX_TTS_LANGUAGE=English
YAAIA_MLX_STT_MODEL=mlx-community/whisper-large-v3-turbo-asr-fp16

# Optional AI overrides. By default YAAIA imports ~/yaaia/appData/config.json from the old app.
YAAIA_AI_PROVIDER=
YAAIA_OPENROUTER_API_KEY=
YAAIA_OPENROUTER_MODEL=
YAAIA_CLAUDE_API_KEY=
YAAIA_CLAUDE_MODEL=
